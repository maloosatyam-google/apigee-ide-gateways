<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables continueOnError="true" enabled="true" name="EV-RequestDetails">
  <DisplayName>EV-RequestDetails</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <!-- Extract project, location, Claude model ID, and action from Vertex Anthropic paths (with or without leading /v1) -->
  <URIPath>
    <Pattern ignoreCase="true">/v1/projects/{project}/locations/{location}/publishers/anthropic/models/{model}:{action}</Pattern>
    <Pattern ignoreCase="true">/projects/{project}/locations/{location}/publishers/anthropic/models/{model}:{action}</Pattern>
    <Pattern ignoreCase="true">/models/{model}:{action}</Pattern>
  </URIPath>
  <VariablePrefix>flow</VariablePrefix>
</ExtractVariables>
