<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="vertex-stream">
  <Description>Vertex AI OpenAI SSE streaming (/endpoints/openapi/chat/completions) with EventFlow Model Armor, token counting &amp; analytics</Description>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>AM-RemoveAuthorization</Name>
      </Step>
      <Step>
        <Name>AM-RouteVertexStream</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <PostFlow name="PostFlow">
    <Request/>
    <Response/>
  </PostFlow>
  <EventFlow content-type="text/event-stream">
    <Response>
      <Step>
        <Name>SMR-SanitizeModelResponseSSE</Name>
        <Condition>response.event.current.data != null and response.event.current.data != "" and !(response.event.current.data JavaRegex "^\[DONE\].*")</Condition>
      </Step>
      <Step>
        <Name>JS-ProcessStreamEvent</Name>
      </Step>
      <Step>
        <Name>LTQ-TokenCountSSE</Name>
        <Condition>flow.stream_done = "true"</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>flow.stream_done = "true"</Condition>
      </Step>
    </Response>
  </EventFlow>
  <Flows/>
  <HTTPTargetConnection>
    <Properties>
      <Property name="response.streaming.enabled">true</Property>
      <Property name="keepalive.timeout.millis">300000</Property>
      <Property name="io.timeout.millis">300000</Property>
    </Properties>
    <URL>https://aiplatform.googleapis.com</URL>
    <Authentication>
      <GoogleAccessToken>
        <Scopes>
          <Scope>https://www.googleapis.com/auth/cloud-platform</Scope>
        </Scopes>
      </GoogleAccessToken>
    </Authentication>
  </HTTPTargetConnection>
</TargetEndpoint>
