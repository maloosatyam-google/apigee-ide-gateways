<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="github-copilot-gateway-v1">
  <DisplayName>GitHub Copilot Enterprise Gateway (Vertex AI Gemini &amp; Claude)</DisplayName>
  <Description>Enterprise Gateway proxy for GitHub Copilot (VS Code BYOK &amp; CLI) and OpenAI-compatible clients (/github-copilot/v1) routing to Google Cloud Vertex AI (Gemini &amp; Claude) with API Key + JWT identity attribution, Model Armor sanitization, LLMTokenQuota enforcement, SSE EventFlow streaming, KVM cost calculation, and Cloud Logging.</Description>
  <Policies>
    <Policy>AM-ModelsResponse</Policy>
    <Policy>AM-NormalizeModel</Policy>
    <Policy>AM-RemoveAuthorization</Policy>
    <Policy>AM-RouteVertex</Policy>
    <Policy>AM-RouteVertexStream</Policy>
    <Policy>AM-SetResponseHeaders</Policy>
    <Policy>AM-SetUserIdentity</Policy>
    <Policy>CORS</Policy>
    <Policy>DC-FaultAnalytics</Policy>
    <Policy>DC-ModelAnalytics</Policy>
    <Policy>DJWT-ExtractUserIdentity</Policy>
    <Policy>EV-ExtractAPIKey</Policy>
    <Policy>EV-ExtractBearerToken</Policy>
    <Policy>EV-ModelResponse</Policy>
    <Policy>JS-CalculateCost</Policy>
    <Policy>JS-FormatClaudeSSE</Policy>
    <Policy>JS-NormalizeOpenAIRequest</Policy>
    <Policy>JS-ProcessStreamEvent</Policy>
    <Policy>JS-TransformClaudeToOpenAI</Policy>
    <Policy>KVM-GetModelRates</Policy>
    <Policy>LTQ-TokenCount</Policy>
    <Policy>LTQ-TokenCountSSE</Policy>
    <Policy>LTQ-TokenEnforce</Policy>
    <Policy>ML-CloudLogging</Policy>
    <Policy>RF-UnsupportedPath</Policy>
    <Policy>SMR-SanitizeModelResponse</Policy>
    <Policy>SMR-SanitizeModelResponseSSE</Policy>
    <Policy>SUP-UserPrompt</Policy>
    <Policy>VA-VerifyAPIKey</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>jsc://CalculateCost.js</Resource>
    <Resource>jsc://FormatClaudeSSE.js</Resource>
    <Resource>jsc://NormalizeOpenAIRequest.js</Resource>
    <Resource>jsc://ProcessStreamEvent.js</Resource>
    <Resource>jsc://TransformClaudeToOpenAI.js</Resource>
  </Resources>
  <TargetEndpoints>
    <TargetEndpoint>vertex</TargetEndpoint>
    <TargetEndpoint>vertex-stream</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
