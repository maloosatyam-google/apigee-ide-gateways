<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Unified Multi-Assistant IDE & Copilot Enterprise Gateway (ide-gateway-v1)
  Single Apigee X proxy (/ide-gateway/v1) serving all 4 AI coding assistants & Copilots:
    1. Google Antigravity (agy CLI & Desktop App)          - GenAI & v1internal wire protocols (/v1beta/models/*, /v1internal:*)
    2. Anthropic Claude Code & Claude Desktop App          - Anthropic Messages (/v1/messages) & Vertex (:rawPredict/:streamRawPredict)
    3. GitHub Copilot (VS Code BYOK & CLI)                 - OpenAI Chat Completions (/v1/chat/completions)
    4. Microsoft Copilot (Copilot Studio & Azure OpenAI)   - Azure OpenAI Deployments (/openai/deployments/{model}/chat/completions)
-->
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS</Name>
      </Step>
      <Step>
        <Name>EV-ExtractAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>RF-UnsupportedPath</Name>
        <Condition>!((request.verb = "GET") and (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?(/openai)?/(models|deployments)$")) and !((request.verb = "POST") and ((proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/models/[A-Za-z0-9.\-]+:(generateContent|streamGenerateContent)$") or (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(generateContent|streamGenerateContent|recordCodeAssistMetrics|registerInteraction|recordInteraction)$") or (proxy.pathsuffix JavaRegex "^(/v1)?/messages(/count_tokens)?$") or (proxy.pathsuffix JavaRegex "^/v1/projects/[^/]+/locations/[^/]+/publishers/anthropic/models/[A-Za-z0-9.\-@]+:(rawPredict|streamRawPredict|countTokens)$") or (proxy.pathsuffix JavaRegex "^(/v1)?(/openai/deployments/[^/]+)?/chat/completions$")))</Condition>
      </Step>
      <Step>
        <Name>JS-NormalizeOpenAIRequest</Name>
        <Condition>(request.verb = "POST") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>AM-NormalizeModel</Name>
        <Condition>(request.verb = "POST") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>EV-ExtractBearerToken</Name>
      </Step>
      <Step>
        <Name>DJWT-ExtractUserIdentity</Name>
        <Condition>flow.rawToken != null</Condition>
      </Step>
      <Step>
        <Name>AM-SetUserIdentity</Name>
        <Condition>(jwt.DJWT-ExtractUserIdentity.decoded.claim.email != null) or (jwt.DJWT-ExtractUserIdentity.claim.email != null)</Condition>
      </Step>
      <Step>
        <Name>SUP-UserPrompt</Name>
        <Condition>(request.verb = "POST") and (flow.userPrompt != null) and (flow.userPrompt != "")</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenEnforce</Name>
        <Condition>(request.verb = "POST") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$") and !(proxy.pathsuffix JavaRegex "^.*(count_tokens|:countTokens)$")</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="ListModels">
      <Description>Unified Model Discovery endpoint (GET /v1/models, GET /v1beta/models, GET /openai/deployments)</Description>
      <Request/>
      <Response>
        <Step>
          <Name>AM-ModelsResponse</Name>
        </Step>
      </Response>
      <Condition>(request.verb = "GET") and (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?(/openai)?/(models|deployments)$")</Condition>
    </Flow>
    <Flow name="TelemetryEndpoints">
      <Description>Acknowledge Antigravity /v1internal:* telemetry endpoints with 200 OK ({})</Description>
      <Request/>
      <Response>
        <Step>
          <Name>AM-AckTelemetry</Name>
        </Step>
      </Response>
      <Condition>proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>JS-TransformClaudeToOpenAI</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.openai_to_claude = "true")</Condition>
      </Step>
      <Step>
        <Name>EV-ModelResponse</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.is_stream != "true") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>KVM-GetModelRates</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>JS-CalculateCost</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.is_stream != "true") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenCount</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.is_stream != "true") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$") and !(proxy.pathsuffix JavaRegex "^.*(count_tokens|:countTokens)$")</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.is_stream != "true") and (flow.responseText != null) and (flow.responseText != "")</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.is_stream != "true") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>AM-SetResponseHeaders</Name>
        <Condition>(request.verb = "POST") and (flow.is_stream != "true") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")</Condition>
      </Step>
      <Step>
        <Name>JS-FormatClaudeSSE</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and (flow.openai_to_claude = "true") and (flow.client_stream = "true")</Condition>
      </Step>
    </Response>
  </PostFlow>
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <DefaultFaultRule name="attribute-fault-to-user">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>DC-FaultAnalytics</Name>
    </Step>
  </DefaultFaultRule>
  <HTTPProxyConnection>
    <BasePath>/ide-gateway/v1</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="models-list">
    <Condition>(request.verb = "GET") and (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?(/openai)?/(models|deployments)$")</Condition>
  </RouteRule>
  <RouteRule name="telemetry-ack">
    <Condition>proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"</Condition>
  </RouteRule>
  <RouteRule name="vertex-stream">
    <Condition>flow.is_stream = "true"</Condition>
    <TargetEndpoint>vertex-stream</TargetEndpoint>
  </RouteRule>
  <RouteRule name="vertex">
    <TargetEndpoint>vertex</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
