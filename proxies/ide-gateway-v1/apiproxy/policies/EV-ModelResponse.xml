<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables async="false" continueOnError="true" enabled="true" name="EV-ModelResponse">
  <DisplayName>EV-ModelResponse</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <JSONPayload>
    <!-- GenAI format -->
    <Variable name="promptTokenCount" type="integer">
      <JSONPath>$.usageMetadata.promptTokenCount</JSONPath>
    </Variable>
    <Variable name="candidatesTokenCount" type="integer">
      <JSONPath>$.usageMetadata.candidatesTokenCount</JSONPath>
    </Variable>
    <Variable name="totalTokenCount" type="integer">
      <JSONPath>$.usageMetadata.totalTokenCount</JSONPath>
    </Variable>
    <Variable name="responseText" type="string">
      <JSONPath>$.candidates[0].content.parts[0].text</JSONPath>
    </Variable>
    <!-- Anthropic Claude format -->
    <Variable name="promptTokenCount" type="integer">
      <JSONPath>$.usage.input_tokens</JSONPath>
    </Variable>
    <Variable name="candidatesTokenCount" type="integer">
      <JSONPath>$.usage.output_tokens</JSONPath>
    </Variable>
    <Variable name="responseText" type="string">
      <JSONPath>$.content[0].text</JSONPath>
    </Variable>
    <!-- OpenAI Chat Completions format -->
    <Variable name="promptTokenCount" type="integer">
      <JSONPath>$.usage.prompt_tokens</JSONPath>
    </Variable>
    <Variable name="candidatesTokenCount" type="integer">
      <JSONPath>$.usage.completion_tokens</JSONPath>
    </Variable>
    <Variable name="totalTokenCount" type="integer">
      <JSONPath>$.usage.total_tokens</JSONPath>
    </Variable>
    <Variable name="responseText" type="string">
      <JSONPath>$.choices[0].message.content</JSONPath>
    </Variable>
  </JSONPayload>
  <Source clearPayload="false">response</Source>
  <VariablePrefix>flow</VariablePrefix>
</ExtractVariables>
