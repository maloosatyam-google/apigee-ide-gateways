<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="ide-gateway-v1">
  <DisplayName>Unified AI Coding Assistants Gateway (Antigravity, Claude Code, GitHub Copilot)</DisplayName>
  <Description>Unified Apigee X Enterprise Gateway routing Google Antigravity (GenAI wire protocol), Anthropic Claude Code (Vertex Anthropic wire protocol), and GitHub Copilot (OpenAI Chat Completions wire protocol) to Vertex AI.</Description>
  <BasePaths>/ide-gateway/v1</BasePaths>
  <Policies>
    <Policy>AM-AckTelemetry</Policy>
    <Policy>AM-NormalizeModel</Policy>
    <Policy>AM-OverrideFlashLitePreview</Policy>
    <Policy>AM-RemoveAuthorization</Policy>
    <Policy>AM-RouteOpenAI</Policy>
    <Policy>AM-RouteVertex</Policy>
    <Policy>AM-RouteVertexStream</Policy>
    <Policy>AM-SetResponseHeaders</Policy>
    <Policy>AM-SetUserIdentity</Policy>
    <Policy>CORS</Policy>
    <Policy>DC-FaultAnalytics</Policy>
    <Policy>DC-ModelAnalytics</Policy>
    <Policy>DJWT-ExtractUserIdentity</Policy>
    <Policy>EV-ExtractAPIKey</Policy>
    <Policy>EV-ExtractBearerToken</Policy>
    <Policy>EV-ModelResponse</Policy>
    <Policy>EV-RequestDetails</Policy>
    <Policy>JS-CalculateCost</Policy>
    <Policy>JS-NormalizeOpenAIRequest</Policy>
    <Policy>KVM-GetModelRates</Policy>
    <Policy>ML-CloudLogging</Policy>
    <Policy>RF-UnsupportedPath</Policy>
    <Policy>VA-VerifyAPIKey</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>jsc://CalculateCost.js</Resource>
    <Resource>jsc://NormalizeOpenAIRequest.js</Resource>
  </Resources>
  <TargetEndpoints>
    <TargetEndpoint>vertex</TargetEndpoint>
    <TargetEndpoint>vertex-claude</TargetEndpoint>
    <TargetEndpoint>vertex-claude-stream</TargetEndpoint>
    <TargetEndpoint>vertex-openapi</TargetEndpoint>
    <TargetEndpoint>vertex-openapi-stream</TargetEndpoint>
    <TargetEndpoint>vertex-stream</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
