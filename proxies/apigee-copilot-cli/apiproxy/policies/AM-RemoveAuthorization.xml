<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-RemoveAuthorization">
  <DisplayName>AM-RemoveAuthorization</DisplayName>
  <!-- Strip client gateway credentials so GoogleAccessToken authenticates to Vertex AI, while preserving User-Agent, X-Goog-Api-Client, X-Goog-User-Project, and custom X-* attribution headers -->
  <Remove>
    <Headers>
      <Header name="x-api-key"/>
      <Header name="x-apikey"/>
      <Header name="x-goog-api-key"/>
      <Header name="Authorization"/>
      <Header name="X-Identity-Token"/>
      <Header name="X-User-Email"/>
    </Headers>
  </Remove>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <AssignTo createNew="false" transport="http" type="request"/>
</AssignMessage>
