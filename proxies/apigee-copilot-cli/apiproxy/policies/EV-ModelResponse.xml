<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExtractVariables continueOnError="true" enabled="true" name="EV-ModelResponse">
  <DisplayName>EV-ModelResponse</DisplayName>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  <JSONPayload>
    <Variable name="responseModelVersion">
      <JSONPath>$.model</JSONPath>
    </Variable>
    <Variable name="promptTokenCount">
      <JSONPath>$.usage.prompt_tokens</JSONPath>
    </Variable>
    <Variable name="candidatesTokenCount">
      <JSONPath>$.usage.completion_tokens</JSONPath>
    </Variable>
    <Variable name="totalTokenCount">
      <JSONPath>$.usage.total_tokens</JSONPath>
    </Variable>
    <Variable name="responseText">
      <JSONPath>$.choices[0].message.content</JSONPath>
    </Variable>
  </JSONPayload>
  <Source clearPayload="false">response</Source>
  <VariablePrefix>flow</VariablePrefix>
</ExtractVariables>
