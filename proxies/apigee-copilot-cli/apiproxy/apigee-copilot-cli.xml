<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<APIProxy revision="1" name="apigee-copilot-cli">
  <DisplayName>GitHub Copilot &amp; OpenAI CLI Gateway</DisplayName>
  <Description>Enterprise Apigee X Gateway for GitHub Copilot (VS Code BYOK &amp; CLI) and OpenAI-compatible coding assistants backed by Vertex AI OpenAI Chat Completions (/v1beta1/projects/{org}/locations/global/endpoints/openapi/chat/completions).</Description>
  <BasePaths>/apigee-copilot-cli</BasePaths>
  <Policies>
    <Policy>AM-RemoveAuthorization</Policy>
    <Policy>AM-RouteVertex</Policy>
    <Policy>AM-RouteVertexStream</Policy>
    <Policy>AM-SetUserIdentity</Policy>
    <Policy>CORS</Policy>
    <Policy>DC-FaultAnalytics</Policy>
    <Policy>DC-ModelAnalytics</Policy>
    <Policy>DJWT-ExtractUserIdentity</Policy>
    <Policy>EV-ExtractAPIKey</Policy>
    <Policy>EV-ExtractBearerToken</Policy>
    <Policy>JS-NormalizeOpenAIRequest</Policy>
    <Policy>ML-CloudLogging</Policy>
    <Policy>RF-UnsupportedPath</Policy>
    <Policy>VA-VerifyAPIKey</Policy>
  </Policies>
  <ProxyEndpoints>
    <ProxyEndpoint>default</ProxyEndpoint>
  </ProxyEndpoints>
  <Resources>
    <Resource>jsc://NormalizeOpenAIRequest.js</Resource>
  </Resources>
  <TargetEndpoints>
    <TargetEndpoint>vertex</TargetEndpoint>
    <TargetEndpoint>vertex-stream</TargetEndpoint>
  </TargetEndpoints>
</APIProxy>
