<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-OverrideFlashLitePreview">
  <DisplayName>AM-OverrideFlashLitePreview</DisplayName>
  <!-- agy CLI 1.4+ default utility catalog emits gemini-3.1-flash-lite-preview; Vertex AI publisher ID is gemini-3.1-flash-lite -->
  <AssignVariable>
    <Name>flow.target_model</Name>
    <Value>gemini-3.1-flash-lite</Value>
  </AssignVariable>
  <AssignVariable>
    <Name>flow.quota_model</Name>
    <Value>gemini-3.1-flash-lite</Value>
  </AssignVariable>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
