<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Antigravity Enterprise Gateway (antigravity-gateway-v1)
  Derived from llm-passthrough-v1 and extended for Antigravity Enterprise Proxy Support:
    1. Accepts Gateway API key in Authorization: Bearer <KEY>, x-goog-api-key, or x-apikey.
    2. Preserves Attribution Headers (User-Agent: Antigravity/<version> (aidev_client; auth_method=gateway),
       X-Goog-Api-Client, X-Goog-User-Project, and custom X-* headers) to Vertex AI.
    3. Unbuffered SSE Streaming on POST .../models/{MODEL_ID}:streamGenerateContent?alt=sse
       via vertex-stream TargetEndpoint (response.streaming.enabled=true).
    4. Acknowledges internal telemetry endpoints (/v1internal:recordCodeAssistMetrics,
       /v1internal:registerInteraction, /v1internal:recordInteraction) with 200 OK ({}).
-->
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS</Name>
      </Step>
      <Step>
        <Name>EV-ExtractAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>RF-UnsupportedPath</Name>
        <Condition>(request.verb != "POST") or (!(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/models/gemini[A-Za-z0-9.\-]*:(generateContent|streamGenerateContent)$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"))</Condition>
      </Step>
      <Step>
        <Name>EV-RequestDetails</Name>
      </Step>
      <Step>
        <Name>AM-NormalizeModel</Name>
        <Condition>flow.model != null</Condition>
      </Step>
      <Step>
        <Name>AM-OverrideFlashLitePreview</Name>
        <Condition>flow.model = "gemini-3.1-flash-lite-preview"</Condition>
      </Step>
      <Step>
        <Name>EV-ExtractBearerToken</Name>
      </Step>
      <Step>
        <Name>DJWT-ExtractUserIdentity</Name>
        <Condition>flow.rawToken != null</Condition>
      </Step>
      <Step>
        <Name>AM-SetUserIdentity</Name>
        <Condition>(jwt.DJWT-ExtractUserIdentity.decoded.claim.email != null) or (jwt.DJWT-ExtractUserIdentity.claim.email != null)</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="TelemetryEndpoints">
      <Description>Acknowledge Antigravity /v1internal:* telemetry endpoints with 200 OK ({})</Description>
      <Request/>
      <Response>
        <Step>
          <Name>AM-AckTelemetry</Name>
        </Step>
      </Response>
      <Condition>proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ModelResponse</Name>
        <Condition>(response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>KVM-GetModelRates</Name>
        <Condition>(response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>JS-CalculateCost</Name>
        <Condition>(response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>response.status.code = 200</Condition>
      </Step>
      <Step>
        <Name>AM-SetResponseHeaders</Name>
        <Condition>!(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
    </Response>
  </PostFlow>
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <DefaultFaultRule name="attribute-fault-to-user">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>DC-FaultAnalytics</Name>
    </Step>
  </DefaultFaultRule>
  <HTTPProxyConnection>
    <BasePath>/antigravity/v1</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="telemetry-ack">
    <Condition>proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"</Condition>
  </RouteRule>
  <RouteRule name="vertex-stream">
    <Condition>proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$"</Condition>
    <TargetEndpoint>vertex-stream</TargetEndpoint>
  </RouteRule>
  <RouteRule name="vertex">
    <TargetEndpoint>vertex</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
