<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Antigravity Enterprise Gateway (antigravity-gateway-v1)
  Governs Google Antigravity CLI, App, and ACP Server traffic to Vertex AI Gemini:
    1. CORS preflight & header support (CORS)
    2. API Key authentication via Authorization: Bearer <KEY>, x-goog-api-key, x-apikey, or x-api-key (EV-ExtractAPIKey + VA-VerifyAPIKey)
    3. Gateway Model Discovery endpoint (GET /v1beta/models, GET /v1/models, GET /models -> AM-ModelsResponse)
    4. Per-user identity attribution from API Key developer email or GCP identity JWT
    5. User Prompt & Model Response extraction + Model Armor sanitization (JS-ExtractPromptAndModel + SUP-UserPrompt + SMR-SanitizeModelResponse / SMR-SanitizeModelResponseSSE)
    6. Token Limiting via API Product llmOperationGroup (LTQ-TokenEnforce + LTQ-TokenCount / LTQ-TokenCountSSE)
    7. Unbuffered SSE Streaming on POST .../models/{MODEL_ID}:streamGenerateContent?alt=sse with EventFlow analytics & token counting
    8. Acknowledges internal telemetry endpoints (/v1internal:recordCodeAssistMetrics, /v1internal:registerInteraction, /v1internal:recordInteraction) with 200 OK ({})
    9. Cloud Logging audit trail including prompt & response text in PostClientFlow (ML-CloudLogging)
-->
<ProxyEndpoint name="default">
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>CORS</Name>
      </Step>
      <Step>
        <Name>EV-ExtractAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>VA-VerifyAPIKey</Name>
        <Condition>request.verb != "OPTIONS"</Condition>
      </Step>
      <Step>
        <Name>RF-UnsupportedPath</Name>
        <Condition>!((request.verb = "GET") and (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/models$")) and !((request.verb = "POST") and ((proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/models/gemini[A-Za-z0-9.\-]*:(generateContent|streamGenerateContent)$") or (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$")))</Condition>
      </Step>
      <Step>
        <Name>EV-RequestDetails</Name>
        <Condition>request.verb = "POST"</Condition>
      </Step>
      <Step>
        <Name>JS-ExtractPromptAndModel</Name>
        <Condition>(request.verb = "POST") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>AM-NormalizeModel</Name>
        <Condition>(request.verb = "POST") and (flow.model != null)</Condition>
      </Step>
      <Step>
        <Name>AM-OverrideFlashLitePreview</Name>
        <Condition>flow.model = "gemini-3.1-flash-lite-preview"</Condition>
      </Step>
      <Step>
        <Name>EV-ExtractBearerToken</Name>
      </Step>
      <Step>
        <Name>DJWT-ExtractUserIdentity</Name>
        <Condition>flow.rawToken != null</Condition>
      </Step>
      <Step>
        <Name>AM-SetUserIdentity</Name>
        <Condition>(jwt.DJWT-ExtractUserIdentity.decoded.claim.email != null) or (jwt.DJWT-ExtractUserIdentity.claim.email != null)</Condition>
      </Step>
      <Step>
        <Name>SUP-UserPrompt</Name>
        <Condition>(request.verb = "POST") and (flow.userPrompt != null) and (flow.userPrompt != "")</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenEnforce</Name>
        <Condition>(request.verb = "POST") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="ListModels">
      <Description>GenAI /v1beta/models discovery endpoint for Antigravity Tier 3 Gateway discovery</Description>
      <Request/>
      <Response>
        <Step>
          <Name>AM-ModelsResponse</Name>
        </Step>
      </Response>
      <Condition>(request.verb = "GET") and (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/models$")</Condition>
    </Flow>
    <Flow name="TelemetryEndpoints">
      <Description>Acknowledge Antigravity /v1internal:* telemetry endpoints with 200 OK ({})</Description>
      <Request/>
      <Response>
        <Step>
          <Name>AM-AckTelemetry</Name>
        </Step>
      </Response>
      <Condition>proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request/>
    <Response>
      <Step>
        <Name>EV-ModelResponse</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>LTQ-TokenCount</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>KVM-GetModelRates</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>JS-CalculateCost</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>SMR-SanitizeModelResponse</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$") and (flow.responseText != null) and (flow.responseText != "")</Condition>
      </Step>
      <Step>
        <Name>DC-ModelAnalytics</Name>
        <Condition>(request.verb = "POST") and (response.status.code = 200) and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
      <Step>
        <Name>AM-SetResponseHeaders</Name>
        <Condition>(request.verb = "POST") and !(proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$") and !(proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:.*$")</Condition>
      </Step>
    </Response>
  </PostFlow>
  <PostClientFlow name="PostClientFlow">
    <Response>
      <Step>
        <Name>ML-CloudLogging</Name>
      </Step>
    </Response>
  </PostClientFlow>
  <DefaultFaultRule name="attribute-fault-to-user">
    <AlwaysEnforce>true</AlwaysEnforce>
    <Step>
      <Name>DC-FaultAnalytics</Name>
    </Step>
  </DefaultFaultRule>
  <HTTPProxyConnection>
    <BasePath>/antigravity/v1</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="models-list">
    <Condition>(request.verb = "GET") and (proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/models$")</Condition>
  </RouteRule>
  <RouteRule name="telemetry-ack">
    <Condition>proxy.pathsuffix JavaRegex "^(/v1beta|/v1)?/v1internal:(recordCodeAssistMetrics|registerInteraction|recordInteraction)$"</Condition>
  </RouteRule>
  <RouteRule name="vertex-stream">
    <Condition>proxy.pathsuffix JavaRegex "^.*:streamGenerateContent$"</Condition>
    <TargetEndpoint>vertex-stream</TargetEndpoint>
  </RouteRule>
  <RouteRule name="vertex">
    <TargetEndpoint>vertex</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
