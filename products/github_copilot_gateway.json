{
  "name": "GitHub Copilot Enterprise Gateway",
  "displayName": "GitHub Copilot Enterprise Gateway",
  "description": "Enterprise Gateway product for GitHub Copilot (VS Code BYOK & CLI) through github-copilot-gateway-v1 (/github-copilot/v1) with per-model LLMTokenQuota governance across Gemini and Claude models.",
  "approvalType": "auto",
  "attributes": [
    {
      "name": "access",
      "value": "private"
    }
  ],
  "environments": [
    "dev"
  ],
  "operationGroup": {
    "operationConfigs": [
      {
        "apiSource": "github-copilot-gateway-v1",
        "operations": [
          {
            "resource": "/**",
            "methods": [
              "GET",
              "POST",
              "OPTIONS"
            ]
          }
        ]
      }
    ],
    "operationConfigType": "proxy"
  },
  "llmOperationGroup": {
    "operationConfigs": [
      {
        "apiSource": "github-copilot-gateway-v1",
        "llmOperations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "gemini-4-argon"
          }
        ],
        "llmTokenQuota": {
          "limit": "100000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "github-copilot-gateway-v1",
