      },
      {
        "apiSource": "claude-gateway-v1",
        "operations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ]
          }
        ]
      },
      {
        "apiSource": "apigee-copilot-cli",
        "operations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ]
          }
        ]
      }
    ],
