{
  "name": "Antigravity Enterprise Gateway",
  "displayName": "Antigravity Enterprise Gateway",
  "description": "Enterprise Gateway product for Google Antigravity CLI (agy), App, and ACP Server through antigravity-gateway-v1 (/antigravity/v1) with per-model LLMTokenQuota governance.",
  "approvalType": "auto",
  "attributes": [
    {
      "name": "access",
      "value": "private"
    }
  ],
  "environments": [
    "dev"
  ],
  "operationGroup": {
    "operationConfigs": [
      {
        "apiSource": "antigravity-gateway-v1",
        "operations": [
          {
            "resource": "/**",
            "methods": [
              "GET",
              "POST"
            ]
          }
        ]
      }
    ],
    "operationConfigType": "proxy"
  },
  "llmOperationGroup": {
    "operationConfigs": [
      {
        "apiSource": "antigravity-gateway-v1",
        "llmOperations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "gemini-3.8-flash"
          }
        ],
        "llmTokenQuota": {
          "limit": "100000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "antigravity-gateway-v1",
        "llmOperations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "gemini-3.6-flash"
          }
        ],
        "llmTokenQuota": {
          "limit": "100000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "antigravity-gateway-v1",
        "llmOperations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "gemini-3.1-pro-preview"
          }
        ],
        "llmTokenQuota": {
          "limit": "100000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
        "apiSource": "antigravity-gateway-v1",
        "llmOperations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "gemini-3.1-flash-lite"
          }
        ],
        "llmTokenQuota": {
          "limit": "100000",
          "interval": "1",
          "timeUnit": "minute"
        }
      },
      {
