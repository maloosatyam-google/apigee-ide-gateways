{
  "name": "Claude Code CLI Gateway",
  "displayName": "Claude Code CLI Gateway",
  "description": "Enterprise Gateway product for Anthropic Claude Code CLI through claude-gateway-v1 (/claude/v1) with per-model LLMTokenQuota governance.",
  "approvalType": "auto",
  "attributes": [
    {
      "name": "access",
      "value": "private"
    }
  ],
  "environments": [
    "dev"
  ],
  "operationGroup": {
    "operationConfigs": [
      {
        "apiSource": "claude-gateway-v1",
        "operations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ]
          }
        ]
      }
    ],
    "operationConfigType": "proxy"
  },
  "llmOperationGroup": {
    "operationConfigs": [
      {
        "apiSource": "claude-gateway-v1",
        "llmOperations": [
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-sonnet-5"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-opus-5-5"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-haiku-5-5"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-sonnet-4-6"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-opus-4-6"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-sonnet-4-5"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-opus-4-5"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-haiku-4-5"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-3-7-sonnet"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-3-5-sonnet-v2"
          },
          {
            "resource": "/**",
            "methods": [
              "POST"
            ],
            "model": "claude-3-5-haiku"
          }
        ],
        "llmTokenQuota": {
          "limit": "100000",
          "interval": "1",
          "timeUnit": "minute"
        }
      }
    ]
  }
}
